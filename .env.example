# The key accepted by POST /api/v1/traces. Use a unique, high-entropy value.
AGENTLENS_API_KEY=replace-with-a-long-random-secret

# ClickHouse HTTP endpoint and credentials. Example: http://localhost:8123
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=agentlens
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
